# Dify v1.15.0 环境变量示例
# 复制此文件为 .env 并填入实际值

# ============================================
# 数据库配置
# ============================================
DATABASE_URL=postgresql://postgres:password@dify-postgres:5432/dify_prod
DATABASE_POOL_SIZE=200
DATABASE_POOL_RECYCLE=3600

# ============================================
# Redis 配置
# ============================================
REDIS_URL=redis://dify-redis:6379/0
REDIS_MAX_CONNECTIONS=100
REDIS_KEY_PREFIX=dify:prod:

# ============================================
# 应用配置
# ============================================
SECRET_KEY=your-secret-key-here-at-least-32-characters-long
FLASK_ENV=production
LOG_LEVEL=INFO

# ============================================
# LLM 配置
# ============================================
OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE=https://api.openai.com/v1

# ============================================
# 向量数据库配置
# ============================================
VECTOR_STORE=weaviate
WEAVIATE_URL=http://dify-weaviate:8080

# ============================================
# Celery 配置
# ============================================
CELERY_BROKER_URL=redis://dify-redis:6379/1
CELERY_RESULT_BACKEND=redis://dify-redis:6379/2
CELERY_QUEUES=default,workflow_based_app_execution,dataset_summary

# ============================================
# 协作功能
# ============================================
ENABLE_COLLABORATION_MODE=true

# ============================================
# 设备流程限流
# ============================================
DEVICE_FLOW_APPROVE_RATE_LIMIT_PER_HOUR=10

# ============================================
# 可观测性
# ============================================
LANGFUSE_API_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=

# ============================================
# 邮件配置（可选）
# ============================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@dify.ai

# ============================================
# 其他配置
# ============================================
TIMEZONE=UTC
ASSERTION_URL=
FILE_UPLOAD_MAX_SIZE=104857600